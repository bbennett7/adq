# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection Details
# Use the "pooled" connection string for serverless/edge functions
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Shared secret used to authenticate on-demand cache revalidation requests from the admin tool
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=your-secret-here

# Pino log level — trace | debug | info | warn | error | fatal | silent (default: info)
LOG_LEVEL=info

# PostHog analytics (client-side — NEXT_PUBLIC_ prefix required)
# Get from: https://us.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — email subscriber collection
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
# Get from: https://resend.com/audiences → your audience → ID
RESEND_AUDIENCE_ID=your_audience_id_here
